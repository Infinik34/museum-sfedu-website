# Server
HOST=0.0.0.0
PORT=1337

# Security Keys (Generate random strings for production!)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=salt_string_here
ADMIN_JWT_SECRET=jwt_secret_here
TRANSFER_TOKEN_SALT=transfer_salt_here
JWT_SECRET=jwt_secret_for_users

# Database
# For local dev, leave as SQLite (default). 
# Uncomment and fill below if using PostgreSQL in prod.
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=museum_db
# DATABASE_USERNAME=strapi_user
