{
    "kind": "collectionType",
    "collectionName": "news_items",
    "info": {
        "singularName": "news",
        "pluralName": "news-items",
        "displayName": "Новости"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title"
        },
        "excerpt": {
            "type": "text"
        },
        "content": {
            "type": "richtext"
        },
        "image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images",
                "files"
            ]
        },
        "isPublished": {
            "type": "boolean",
            "default": true
        }
    }
}
