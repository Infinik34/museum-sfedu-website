        },
        "email": {
            "type": "email"
        },
        "phone": {
            "type": "string",
            "required": true
        },
        "time": {
            "type": "string",
            "required": true
        },
        "processed": {
            "type": "boolean",
            "required": true,
            "default": false
        }
    }
