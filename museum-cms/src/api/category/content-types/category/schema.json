{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Категории"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "exhibits": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::exhibit.exhibit",
      "inversedBy": "categories"
    },
    "isMain": {
      "type": "boolean",
      "required": false,
      "default": false
    }
  }
}
